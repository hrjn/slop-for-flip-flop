{
  "schemaVersion": 2,
  "kind": "app",
  "name": "slop-for-flip-flop",
  "deployment": {
    "organizationId": "3fbdc95a-16ce-4532-b77f-e8836f047a29",
    "workspaceId": "6340e568-a546-4c41-9dee-1fbeb80493e1",
    "appId": "01a1b1f4-f7e8-7186-b471-7db260c785d4"
  },
  "modules": [
    {
      "type": "app",
      "name": "api",
      "path": "apps/api",
      "routes": [
        {
          "path": "/api"
        }
      ],
      "port": 3000,
      "serve": "server",
      "runtime": "python",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.api",
        "target": "api"
      },
      "dev": {
        "startCommand": "uv run --all-packages python -m api.dev",
        "preStartCommands": [
          "uv run --all-packages python -m cli pre-start"
        ]
      },
      "deploy": {
        "startCommand": "uv run --frozen --no-dev --no-sync uvicorn api.main:app --host \"$HOST\" --port \"$PORT\" --proxy-headers --timeout-graceful-shutdown 20",
        "preStartCommands": [
          "uv run --frozen --no-dev --no-sync python -m cli pre-start"
        ]
      }
    },
    {
      "type": "app",
      "name": "web",
      "path": "apps/web",
      "routes": [
        {
          "path": "/"
        }
      ],
      "port": 3001,
      "serve": "static",
      "runtime": "node",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.web",
        "target": "runtime"
      },
      "dev": {
        "startCommand": "bun run dev"
      },
      "deploy": {
        "startCommand": "node .output/server/index.mjs"
      }
    },
    {
      "type": "managed",
      "name": "postgres",
      "engine": "postgres"
    }
  ]
}
